# Sender serial settings
SENDER_SERIAL_PORTS=/dev/ttyUSB0,/dev/ttyUSB1
SENDER_BAUDRATE=115200

# Receiver Raspberry Pi address used by sender
RECEIVER_HOST=192.168.100.200
RECEIVER_PORT=5000

# Motion detection
MOVEMENT_THRESHOLD=0.35
STOP_TIMEOUT=0.5
DISPLAY_INTERVAL=0.2

# Receiver socket and local output
RECEIVER_BIND_HOST=0.0.0.0
RECEIVER_BIND_PORT=5000
LOG_FILE=motion_log.jsonl
BATCH_SIZE=10

# FTP targets for receiver batch upload
FTP_TARGETS_JSON=[{"host":"192.168.100.7","user":"user1","password":"password1","upload_dir":""},{"host":"192.168.100.8","user":"user2","password":"password2","upload_dir":""}]
